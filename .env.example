# Public deployment origin, with HTTPS and no path or trailing query.
SITE_URL=https://wages-calculator.com

# This owner-supplied ID is also the default when this variable is unset.
# An explicitly blank value removes the AdSense script, metadata, and ads.txt.
ADSENSE_PUBLISHER_ID=ca-pub-8379301195677583

# These flags gate manual ad placements, not the production AdSense script.
# Enable manual ads only after approval and publishing Google's consent messages.
# Auto ads are controlled separately in the AdSense dashboard.
ADSENSE_ENABLED=false
ADSENSE_CONSENT_READY=false

# manual places a single responsive unit below the calculator/on guide pages.
# auto uses dashboard placement settings; exclude calculator controls and policy pages.
ADSENSE_MODE=manual
ADSENSE_SLOT=

# Optional Search Console HTML verification token (not the complete meta tag).
GOOGLE_SITE_VERIFICATION=

# Set these in your hosting dashboard/shell, or copy this file to .env.local.
# The build preserves hosting/shell variables, then reads .env.production.local,
# .env.local, .env.production, and .env, with earlier values taking precedence.
# Do not put credentials in this example file or commit your .env.local file.
# VERCEL_ENV is supplied by Vercel; preview/development builds omit the script.
# A production export includes the script even if that artifact is served locally.
# Vercel Web Analytics needs no ID here; enable it in the Vercel project dashboard.
# Google Analytics is not installed. No Google Analytics ID is consumed by this project.
