# Public deployment origin, with HTTPS and no path or trailing query.
SITE_URL=https://wages-calculator.com

# Copy the actual publisher ID from AdSense; leave blank until you have one.
# A configured ID generates verification metadata and ads.txt even with ads off.
ADSENSE_PUBLISHER_ID=

# Enable only after site approval and publishing Google's required consent messages.
ADSENSE_ENABLED=false
ADSENSE_CONSENT_READY=false

# manual places a single responsive unit below the calculator/on guide pages.
# auto uses dashboard placement settings; exclude calculator controls and policy pages.
ADSENSE_MODE=manual
ADSENSE_SLOT=

# Optional Search Console HTML verification token (not the complete meta tag).
GOOGLE_SITE_VERIFICATION=

# Set these in your hosting dashboard/shell, or copy this file to .env.local.
# The build preserves hosting/shell variables, then reads .env.production.local,
# .env.local, .env.production, and .env, with earlier values taking precedence.
# Do not put credentials in this example file or commit your .env.local file.
# VERCEL_ENV is supplied by Vercel; preview and development builds never serve ads.
# Analytics is not installed. No Google Analytics ID is consumed by this project.
